CompileFlags:
  CompilationDatabase: build

---
If:
  PathMatch: .*src_mcu/bridge/.*
CompileFlags:
  CompilationDatabase: build/ino_bridge

---
If:
  PathMatch: .*src_mcu/hello/.*
CompileFlags:
  CompilationDatabase: build/ino_hello

---
If:
  PathMatch: .*src_mcu/rtos/.*
CompileFlags:
  CompilationDatabase: build/ino_rtos
